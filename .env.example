# Contact form delivery (app/api/contact/route.ts).
# Copy to .env.local for local dev; set these in the host for production.

# Resend API key. Without it the route logs and 200s in dev, and 500s in prod.
RESEND_API_KEY=

# Where trading requests land. Defaults to sales@eratree.io.
CONTACT_TO_EMAIL=sales@eratree.io

# Sender. Must be on a domain verified in Resend.
CONTACT_FROM_EMAIL="EraTree Website <noreply@eratree.io>"
