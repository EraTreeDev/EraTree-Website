{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "eratree-website",
	"compatibility_date": "2026-08-21",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"vars": {
		// Contact-form sender. Must sit on a domain verified in Resend — we verify
		// the send.eratree.io subdomain so the root SPF/MX (Microsoft 365) stay untouched.
		"CONTACT_FROM_EMAIL": "EraTree Website <noreply@send.eratree.io>"
	},
	// All four hostnames are listed so a deploy never detaches one that was
	// attached from the dashboard. eratree.io stays attached because it must keep
	// answering — it carries the redirect to eratree.com, and its DNS still
	// carries company email, which nothing here touches.
	"workers_dev": true,
	"routes": [
		{ "pattern": "eratree.io", "custom_domain": true },
		{ "pattern": "www.eratree.io", "custom_domain": true },
		{ "pattern": "eratree.com", "custom_domain": true },
		{ "pattern": "www.eratree.com", "custom_domain": true }
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "eratree-website"
		}
	],
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	}
}
